# Copy to .env.local (gitignored) and fill in. These identify your 1Password
# account/Environment — not secrets themselves, but kept out of source so a
# public clone of this repo doesn't reveal which 1Password account is yours.
#
# The Makefile sources this file automatically if present.

# 1Password account ID (Settings -> Account -> scroll to the bottom, or
# from the 1Password desktop app's URL bar when viewing the account).
OP_ACCOUNT_ID=

# The "tynet-runpod" Environment's ID (Developer -> Environments -> select
# tynet-runpod -> the ID is in the URL/details pane).
OP_ENVIRONMENT_ID=
