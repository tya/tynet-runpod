# Managed by the "tynet-runpod" 1Password Environment — do not edit this copy
# directly if you're using 1Password; it mounts a live-synced .env at
# ~/src/tynet-runpod/.env instead. This file just documents the variable
# names for anyone not using 1Password Environments.

# RunPod API key, used by runpodctl to create/manage the pod.
# https://www.runpod.io/console/user/settings -> API Keys
RUNPOD_API_KEY=

# Hugging Face token. Only needed if MODEL_ID points at a gated model;
# Qwen3-Coder is not gated, so this can stay empty.
HF_TOKEN=

# Bearer token vLLM's Anthropic-compatible endpoint will require. Generate
# your own random value, e.g.: openssl rand -hex 24
VLLM_API_KEY=

# Hugging Face model ID vLLM will serve. Must support tool calling for
# Claude Code's agentic file-edit/bash tool use to work.
MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8

# RunPod GPU type ID (see `runpodctl get gpu-types` or the RunPod console).
GPU_TYPE_ID=NVIDIA A40

# Name for the pod as it appears in the RunPod console.
POD_NAME=tynet-runpod-vllm

# vLLM tool-call parser matching MODEL_ID's family. See:
# https://docs.vllm.ai/en/stable/features/tool_calling/
TOOL_CALL_PARSER=qwen3_xml
